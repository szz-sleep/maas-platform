generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户表
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  email        String?   @unique @db.VarChar(100)
  phone        String?   @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("user") @db.VarChar(20) // user, admin, moderator
  avatarUrl    String?   @map("avatar_url") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  apiKeys       ApiKey[]
  callLogs      CallLog[]
  assets        Asset[]
  assetGroups   AssetGroup[]
  quotaHistory  KeyQuotaHistory[] @relation("AllocatedBy")

  @@map("users")
}

// API Key 表
model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  keyName    String    @map("key_name") @db.VarChar(100)
  keyValue   String    @map("key_value") @unique @db.VarChar(255) // 加密存储
  keyHash    String?   @map("key_hash") @unique @db.VarChar(64)  // 明文 hash，用于 O(1) 查询鉴权
  status     String    @default("pending_quota") @db.VarChar(20) // pending_quota, active, revoked, expired
  quotaTotal Decimal   @default(0) @map("quota_total") @db.Decimal(15,2)
  quotaUsed  Decimal   @default(0) @map("quota_used") @db.Decimal(15,2)
  lastUsed   DateTime? @map("last_used")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  callLogs     CallLog[]
  quotaHistory KeyQuotaHistory[] @relation("Key")
  keyModels    KeyModel[]

  @@map("api_keys")
}

// API Key 与模型的多对多映射（管理员为 Key 自定义可用模型）
model KeyModel {
  id        Int      @id @default(autoincrement())
  apiKeyId  Int      @map("api_key_id")
  modelId   Int      @map("model_id")
  createdAt DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  model  Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, modelId])
  @@map("key_models")
}

// 模型定义表
model Model {
  id              Int       @id @default(autoincrement())
  name            String    @unique @db.VarChar(100) // 平台唯一模型名
  displayName     String    @map("display_name") @db.VarChar(100)
  description     String?   @db.Text
  usageHint       String?   @map("usage_hint") @db.Text
  source          String    @default("volcano") @db.VarChar(20) // volcano, local
  modelType       String    @map("model_type") @db.VarChar(20) // video, image, chat, embedding, audio
  volcanoModelId  String?   @map("volcano_model_id") @db.VarChar(150) // 火山引擎真实模型ID
  volcanoEndpoint String?   @map("volcano_endpoint") @db.VarChar(200) // 火山API端点覆盖
  unitCost        Decimal   @default(0.1) @map("unit_cost") @db.Decimal(10,6) // 单价（元/次，图片/3D按次，视频按秒时此为兜底价）
  per1mInputTokens  Decimal? @map("per_1m_input_tokens") @db.Decimal(10,6) // chat类：输入价格（元/百万tokens）
  per1mOutputTokens Decimal? @map("per_1m_output_tokens") @db.Decimal(10,6) // chat类：输出价格（元/百万tokens）
  unitCostPerSecond Decimal? @map("unit_cost_per_second") @db.Decimal(10,6) // 视频类：单价（元/秒）
  config          Json?     @db.JsonB // 额外配置（自部署服务地址、参数等）
  status          String    @default("offline") @db.VarChar(20) // online, offline, loading
  isHot           Boolean   @default(false) @map("is_hot")
  loadTime        DateTime? @map("load_time")
  createdAt       DateTime  @default(now()) @map("created_at")

  callLogs CallLog[]
  keyModels KeyModel[]

  @@map("models")
}

// 调用日志表
model CallLog {
  id           BigInt    @id @default(autoincrement())
  apiKeyId     Int?       @map("api_key_id")
  userId       Int?       @map("user_id")
  modelId      Int?       @map("model_id")
  promptHash   String?   @map("prompt_hash") @db.VarChar(64)
  responseHash String?   @map("response_hash") @db.VarChar(64)
  tokensInput  Int?      @map("tokens_input")
  tokensOutput Int?      @map("tokens_output")
  durationMs   Int?      @map("duration_ms")
  cost         Decimal?  @db.Decimal(10,4)
  unitInfo     Json?     @map("unit_info") @db.JsonB // { unit, weightedUnit, formula, totalTokens, modelType, resolution }
  status       String    @default("success") @db.VarChar(20) // success, failed, timeout
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  model  Model?  @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([modelId])
  @@index([createdAt])
  @@index([apiKeyId])
  @@map("call_logs")
}

// 模型价格表（火山标准价 + 本地参考价，管理端可配置）
model ModelPrice {
  id            Int      @id @default(autoincrement())
  modelKey      String   @unique @db.VarChar(100) // 匹配模型名/别名（如 doubao-seedance-2.0、deepseek-v4-flash正式版）
  displayName   String?  @map("display_name") @db.VarChar(100)
  modelType     String   @map("model_type") @db.VarChar(20) // chat, video, image, 3d
  source        String   @default("volcano") @db.VarChar(20) // volcano, local
  priceMode     String   @map("price_mode") @db.VarChar(20) // token, per_second, per_image
  // chat / token 模式：元/百万token
  inputPrice    Decimal? @map("input_price") @db.Decimal(10,6)
  outputPrice   Decimal? @map("output_price") @db.Decimal(10,6)
  cacheHitPrice Decimal? @map("cache_hit_price") @db.Decimal(10,6)
  // 视频：分辨率档位 + 输入含/不含视频（元/百万token）
  resolution    String?  @db.VarChar(20) // 480p, 720p, 1080p, 4k
  inputNoVideo  Decimal? @map("input_no_video") @db.Decimal(10,6)
  inputWithVideo Decimal? @map("input_with_video") @db.Decimal(10,6)
  // 视频 per_second 备选（简化计费用）
  perSecond     Decimal? @map("per_second") @db.Decimal(10,6)
  // 图片：元/张（低像素==1.5K、高像素>1.5K）
  perImage      Decimal? @map("per_image") @db.Decimal(10,6)
  perImageHigh  Decimal? @map("per_image_high") @db.Decimal(10,6)
  // 本地模型参考的火山模型
  refModel      String?  @map("ref_model") @db.VarChar(100)
  remark        String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("model_prices")
}

// Key 配额记录表
model KeyQuotaHistory {
  id          BigInt   @id @default(autoincrement())
  keyId       Int      @map("key_id")
  amount      Decimal  @db.Decimal(15,2)
  reason      String?  @db.VarChar(50) // manual, auto, refund
  allocatedBy Int?     @map("allocated_by")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  key      ApiKey @relation("Key", fields: [keyId], references: [id], onDelete: Cascade)
  allocator User?  @relation("AllocatedBy", fields: [allocatedBy], references: [id])

  @@map("key_quota_history")
}

// 素材记录表（用户 ↔ 火山素材库映射）
model Asset {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  assetName    String    @map("asset_name") @db.VarChar(200)
  assetType    String    @map("asset_type") @db.VarChar(20) // image, video, audio
  sourceUrl    String    @map("source_url") @db.Text
  volcAssetId  String?   @map("volc_asset_id") @unique @db.VarChar(100)
  volcStatus   String    @default("pending") @map("volc_status") @db.VarChar(30) // pending, processing, active, failed
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([volcStatus])
  @@map("assets")
}

// 素材组记录表（按用户自动管理）
model AssetGroup {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  volcGroupId    String   @map("volc_group_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("asset_groups")
}

// 系统设置表
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(100)
  value      String?  @db.Text
  type       String   @default("string") @db.VarChar(20)
  description String? @db.Text
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}